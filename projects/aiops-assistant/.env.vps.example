# =============================================================================
# KIRA VPS Edition — Environment Configuration
# =============================================================================

# --- LLM Configuration (any OpenAI-compatible API) ---
# Option 1: KodeKloud API (what you're already using)
LLM_API_KEY=sk-gJ78Srk2iN-3A4zgXcH8uA
LLM_BASE_URL=https://api.ai.kodekloud.com/v1
LLM_MODEL=kodekey-pro

# Option 2: OpenAI
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Option 3: Local Ollama (free, runs on your VPS)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# Option 4: Google Gemini (via OpenAI-compatible endpoint)
# LLM_API_KEY=your_gemini_key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- Infrastructure Mode ---
# "docker" = monitors Docker containers (docker ps, docker logs, docker stats)
# "kubernetes" = monitors K8s pods (kubectl get pods, kubectl logs)
INFRA_MODE=docker

# --- Kubernetes Settings (only needed if INFRA_MODE=kubernetes) ---
# KUBE_NAMESPACE=default

# --- Prometheus (optional, for richer metrics) ---
# If not available, falls back to docker stats
# PROMETHEUS_URL=http://localhost:9090
